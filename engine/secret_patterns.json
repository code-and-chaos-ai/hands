{
  "about": "What counts as a secret on screen. One list, shared by every tool that redacts screenshots. Regexes use the syntax common to Python 're' and JavaScript RegExp: no inline flags (use 'flags'), no named groups, no possessive quantifiers. Each regex runs on OCR text, so it tolerates what OCR does to text: spaces around ':' '/' '.', and look-alike letters. 'checks' apply to capture group 'group' (0 = the whole match): min_len, min_entropy (Shannon bits per char), min_classes (of lower/upper/digit/symbol) unless the value is at least or_min_len long, require_digit, min_upper / min_lower / min_digits (counts), max_hex_share (a value whose letters and digits are almost all hex is a hash or an id, not a key), words_need_digit (every OCR word longer than 2 chars inside the match holds a digit, so ordinary words glued together never pass), reject (a regex that, if it matches the value, means not a secret). kind 'token' = black out the matched text; kind 'block' = the match opens a block that runs down to its END line (private keys). Every regex runs twice: on the OCR words joined by spaces, and joined with no spaces (OCR splits tokens); 'compact': false keeps a pattern off the no-space text, for patterns whose label could be glued to an unrelated neighbour. kind 'random' = not a known secret type, just a long random-looking string: hidden too, but counted apart from secrets. OCR often reads '_' as a space, so prefixes ending in '_' accept a space there.",
  "version": 4,
  "patterns": [
    {
      "id": "db_connection_string",
      "label": "database connection string with a password",
      "regex": "\\b(?:postgres(?:q[l1I|])?|mysql|mariadb|mongodb(?:\\+srv)?|rediss?|amqps?|mssql|sqlserver|cockroachdb|clickhouse)\\s?[:;]\\s?[/\\\\|Il1]{0,2}\\s?[^\\s:@/]{1,64}\\s?:\\s?([^\\s@/]{3,128})",
      "flags": "i",
      "checks": {
        "group": 1,
        "reject": "^\\d+$"
      }
    },
    {
      "id": "url_with_credentials",
      "label": "any URL with user:password@",
      "regex": "\\b[a-z][a-z0-9+.-]{1,15}\\s?:\\s?//\\s?[^\\s:@/]{1,64}\\s?:\\s?([^\\s@/]{3,128})\\s?@",
      "flags": "i",
      "checks": {
        "group": 1,
        "reject": "^\\d+$"
      }
    },
    {
      "id": "anthropic_key",
      "label": "Anthropic API key",
      "regex": "\\bsk-ant-[^\\s\"',;]{8,}",
      "flags": "i"
    },
    {
      "id": "openai_key",
      "label": "OpenAI-style sk- key",
      "regex": "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}",
      "flags": "",
      "checks": {
        "group": 0,
        "min_classes": 3
      }
    },
    {
      "id": "github_token",
      "label": "GitHub token",
      "regex": "\\b(?:gh[pousr][_ ]|github[_ ]pat[_ ])[^\\s\"',;]{10,}",
      "flags": "i"
    },
    {
      "id": "neon_password",
      "label": "Neon database password",
      "regex": "\\bnpg[_ ][^\\s\"',;]{6,}",
      "flags": "i"
    },
    {
      "id": "aws_access_key",
      "label": "AWS access key id",
      "regex": "\\b(?:AKIA|ASIA)[0-9A-Za-z]{10,}",
      "flags": ""
    },
    {
      "id": "slack_token",
      "label": "Slack token",
      "regex": "\\bxox[abposr]-[^\\s\"',;]{8,}",
      "flags": "i"
    },
    {
      "id": "gitlab_token",
      "label": "GitLab token",
      "regex": "\\bg[l1I|i]pat-[^\\s\"',;]{10,}",
      "flags": "i"
    },
    {
      "id": "stripe_key",
      "label": "Stripe secret or restricted key",
      "regex": "(?:sk|rk)\\s?[_ ]{1,3}(?:[l1I|]\\s?i\\s?ve|test)\\s?[_ ]{0,3}[^\\s\"',;]{8,}",
      "flags": "i"
    },
    {
      "id": "stripe_webhook",
      "label": "Stripe webhook secret",
      "regex": "\\bwhsec[_ ][^\\s\"',;]{16,}",
      "flags": "i"
    },
    {
      "id": "google_api_key",
      "label": "Google API key",
      "regex": "\\bAIza[0-9A-Za-z_-]{20,}",
      "flags": ""
    },
    {
      "id": "huggingface_token",
      "label": "Hugging Face token",
      "regex": "\\bhf[_ ][A-Za-z0-9]{20,}",
      "flags": ""
    },
    {
      "id": "hex_sk_key",
      "label": "sk_ + long hex key (ElevenLabs style)",
      "regex": "\\bsk[_ ][a-f0-9]{32,}",
      "flags": "i"
    },
    {
      "id": "telegram_bot_token",
      "label": "Telegram bot token",
      "regex": "\\b\\d{8,10}\\s?:\\s?AA[A-Za-z0-9_-]{25,}",
      "flags": ""
    },
    {
      "id": "jwt",
      "label": "JSON Web Token",
      "regex": "\\bey[Jj][A-Za-z0-9_-]{8,}\\s?\\.\\s?ey[Jj][A-Za-z0-9_-]{4,}",
      "flags": ""
    },
    {
      "id": "jwt_segment",
      "label": "long JWT segment (token cut by the edge or a wrap)",
      "regex": "\\bey[Jj][A-Za-z0-9_-]{30,}",
      "flags": ""
    },
    {
      "id": "bearer_token",
      "label": "Bearer token",
      "regex": "\\bBearer\\s?:?\\s?([A-Za-z0-9._~+/=-]{16,})",
      "flags": "i",
      "checks": {
        "group": 1,
        "min_classes": 2
      }
    },
    {
      "id": "private_key",
      "label": "private key block",
      "regex": "BEGIN\\s?(?:RSA\\s?|EC\\s?|DSA\\s?|OPENSSH\\s?|ENCRYPTED\\s?|PGP\\s?)?PRIVATE\\s?KEY",
      "flags": "i",
      "kind": "block",
      "end_regex": "END\\s?(?:RSA\\s?|EC\\s?|DSA\\s?|OPENSSH\\s?|ENCRYPTED\\s?|PGP\\s?)?PRIVATE\\s?KEY"
    },
    {
      "id": "password_label",
      "label": "a value right after password / pwd",
      "regex": "(?:passw(?:or)?d|pwd|passphrase)[A-Za-z0-9_ -]{0,30}?[^:=A-Za-z0-9\\s]{0,3}\\s?[:=]\\s?[\"'(]?\\s?([^\\s\"',;]{6,})",
      "flags": "i",
      "compact": false,
      "checks": {
        "group": 1,
        "min_classes": 2,
        "or_min_len": 12,
        "reject": "^[*•●·.xX]+$|[(){}$<>]"
      }
    },
    {
      "id": "labeled_secret",
      "label": "a long random value right after key / token / secret",
      "regex": "(?:secret|token|api[_ -]?key|apikey|access[_ -]?key|private[_ -]?key|credential|signing[_ -]?key|key)[A-Za-z0-9_ -]{0,30}?[^:=A-Za-z0-9\\s]{0,3}\\s?[:=]\\s?[\"'(]?\\s?([A-Za-z0-9+/_.~=-]{16,})",
      "flags": "i",
      "compact": false,
      "checks": {
        "group": 1,
        "min_entropy": 3.0,
        "min_classes": 2,
        "require_digit": true
      }
    },
    {
      "id": "password_label_no_separator",
      "label": "a password-looking value right after password / pwd when OCR lost the ':' or '='",
      "regex": "(?:passw(?:or)?d|pwd|passphrase)\\s{1,3}([^\\s\"',;]{8,})",
      "flags": "i",
      "compact": false,
      "checks": {
        "group": 1,
        "min_upper": 1,
        "min_lower": 1,
        "min_digits": 1,
        "reject": "[(){}$<>]"
      }
    },
    {
      "id": "labeled_secret_no_separator",
      "label": "a long random value right after key / token / secret when OCR lost the ':' or '='",
      "regex": "(?:secret|token|api[_ -]?key|apikey|access[_ -]?key|private[_ -]?key|credential|signing[_ -]?key)\\s{1,3}([A-Za-z0-9+/_.~=-]{16,})",
      "flags": "i",
      "compact": false,
      "checks": {
        "group": 1,
        "min_entropy": 3.0,
        "min_classes": 2,
        "require_digit": true
      }
    },
    {
      "id": "password_before_at",
      "label": "a random-looking password right before @host (a connection string whose start OCR lost)",
      "regex": "([^\\s:/@\"'<>]{12,})\\s?@\\s?[A-Za-z0-9-]+\\.[A-Za-z0-9.-]+",
      "flags": "",
      "compact": true,
      "checks": {
        "group": 1,
        "min_upper": 1,
        "min_lower": 1,
        "min_digits": 1,
        "min_entropy": 3.5
      }
    },
    {
      "id": "random_token",
      "label": "a long random-looking string with no label (upper, lower and digits mixed)",
      "regex": "[A-Za-z0-9+/_=-]{24,}",
      "flags": "",
      "kind": "random",
      "checks": {
        "group": 0,
        "min_upper": 2,
        "min_lower": 2,
        "min_digits": 2,
        "min_entropy": 3.8,
        "words_need_digit": true,
        "max_hex_share": 0.8
      }
    }
  ]
}