{
  "manifest_version": 3,
  "name": "Hands",
  "short_name": "Hands",
  "version": "0.2.0",
  "description": "Hands in Chrome: the agent's background tabs in its own tab group, driven through the debugger, with its own cursor.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "nativeMessaging", "storage", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Hands", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } }
}
